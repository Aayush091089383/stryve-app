<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Downloading an assignment PDF needs no storage permission: on Android
         10+ it is written through MediaStore, and on older releases through the
         system Save dialog. file_saver nevertheless declares a legacy
         READ_EXTERNAL_STORAGE permission (it has file-reading features this app
         does not use), so it is removed here rather than asking for access to
         files CampusSync never reads. Its WRITE_EXTERNAL_STORAGE declaration is
         already scoped to API 28 and below. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <!-- Assignment alerts. Android 13+ asks the student at runtime the first
         time one is raised; the in-app bell and Notifications screen work
         whether or not this is granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app updates: the downloaded APK is handed to Android's installer.
         Android 8+ needs this permission for that hand-off; the user must also
         allow "Install unknown apps" for Stryve the first time. The updater
         plugin declares the same permission and its own FileProvider (with
         the applicationId.github_release_apk_updater.fileprovider authority),
         so neither is repeated here - a duplicate provider with the same
         authority would fail the manifest merge. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:label="Stryve"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Pushed assignment alerts (FCM) are posted to the same channel the
             in-app alert uses, so Android's per-category settings silence both
             together instead of leaving a second "Miscellaneous" channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="stryve_assignments" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
