# --- Added during the 2026-10-12 security review ---
# Local secrets and databases must never be committed.
.env
**/.env
*.db
*.db.backup*
*.db.bak
*.sqlite
*.sqlite3
# Local Python virtualenv / build output
backend/venv/
# --- Baseline safety net additions (CampusSync, 2026-10-17) ---
# Timestamp-in-middle DB backups (e.g. campussync.db.<ts>.pre-*.bak)
*.bak
*.backup
*.backup_*
*.broken-backup
campussync.db.*
campussync_backup*

# Python venvs — do not rely on the venv's self-ignoring .gitignore
.venv/
backend/.venv/
venv/
backend/venv/
__pycache__/
*.pyo
.pytest_cache/

# IDE / tool state
.idea/
.vscode/
.claude/
.freebuff/
.opencode/

# Flutter / tooling artifacts
.flutter-plugins
.metadata

# Signing / keys (never commit)
*.jks
*.keystore
android/key.properties

# Firebase server credential: full admin access to the FCM project (it can
# message every device). Only the operator's machine running the backend has
# it; `android/app/google-services.json` is the client config and is not a
# secret, so it stays in the repo.
backend/firebase-service-account.json
**/firebase-service-account*.json

# Logs & runtime junk
*.log
server_job.txt

# Uploaded assignment PDFs are user data, never source. The backend writes
# them under backend/uploads/assignments/ (see config.py); a stray `git add .`
# must not publish another student's file.
backend/uploads/
backend/uploads/*

# Graphify cache
graphify-out/

# Environment templates ARE safe to commit
!.env.example
!**/.env.example
